# Copy to .env for local use. Never commit real values.

# Postgres connection string. In production Vercel + Neon sets this for you.
# Leave empty locally: the dev server then uses an embedded Postgres in .data/
DATABASE_URL=

# Google Gemini key for reading meal photos. Leave empty locally to use a fake demo AI.
GEMINI_API_KEY=

# Optional
# AI_MODELS=gemini-flash-latest,gemini-2.5-flash
# PG_POOL_MAX=3
